{
  "name": "session-explorers-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for the Claude/Codex/pi session explorer VS Code extensions and their shared core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShahadIshraq/claude-session-vs-code-extension.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "lint:fix": "eslint \"packages/*/src/**/*.ts\" --fix",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"**/*.{json,mjs,md}\" \"!**/node_modules/**\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"**/*.{json,mjs,md}\" \"!**/node_modules/**\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/*/src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,mjs,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1"
  }
}
